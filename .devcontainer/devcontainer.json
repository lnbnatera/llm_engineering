{
  "image": "mcr.microsoft.com/vscode/devcontainers/python:trixie",

  "postStartCommand": "[ -x /usr/local/bin/ollama ] && ollama serve",
  "postCreateCommand": "bash .devcontainer/post-create.sh",
  "shutdownAction": "none",

  "forwardPorts": [ 11434 ],

  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "ms-toolsai.jupyter"
      ]
    }
  }
}
